# ==============================================================================
# HEADLESS WORDPRESS & NEXT.JS APP ROUTER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Public or Private WPGraphQL Endpoint (WordPress /graphql URL)
# Example: https://backend.forextradetech.com/graphql
WORDPRESS_API_URL="https://backend.forextradetech.com/graphql"

# Shared secret key between WordPress Customizer / Draft links and Next.js /api/draft
# Used to verify Draft Mode authorization before enabling draftMode().enable()
WORDPRESS_PREVIEW_SECRET="forex_trade_tech_draft_preview_token_2026"

# Shared secret token for the WordPress on-demand revalidation webhook (/api/revalidate)
# Sent in the x-revalidate-secret header or query parameter from WordPress
WORDPRESS_REVALIDATION_SECRET="forex_trade_tech_isr_revalidation_secret_2026"

# Optional: WordPress Application Password or JWT token for authenticated draft fetching
# Needed when draft posts require WordPress authorization to query via WPGraphQL
WORDPRESS_AUTH_TOKEN=""

# Canonical Site URL (e.g., https://forex-trade-technology.vercel.app)
NEXT_PUBLIC_SITE_URL="https://forex-trade-technology.vercel.app"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
