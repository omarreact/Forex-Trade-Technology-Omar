{
  "$schema": "https://schemas.wp.org/wp/6.6/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1180px", "wideSize": "1440px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "navy", "name": "Navy", "color": "#0B1220" },
        { "slug": "slate-900", "name": "Slate 900", "color": "#0F172A" },
        { "slug": "slate-700", "name": "Slate 700", "color": "#334155" },
        { "slug": "slate-500", "name": "Slate 500", "color": "#64748B" },
        { "slug": "slate-100", "name": "Slate 100", "color": "#F1F5F9" },
        { "slug": "mint", "name": "Mint", "color": "#DDF7EC" },
        { "slug": "emerald", "name": "Emerald", "color": "#059669" },
        { "slug": "emerald-dark", "name": "Emerald Dark", "color": "#047857" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "fluid": true,
      "customFontSize": false,
      "fontFamilies": [
        { "slug": "inter", "name": "Inter", "fontFamily": "Inter, Arial, sans-serif" },
        { "slug": "manrope", "name": "Manrope", "fontFamily": "Manrope, Inter, Arial, sans-serif" }
      ],
      "fontSizes": [
        { "slug": "display", "name": "Display / H1", "size": "50px", "fluid": { "min": "28.836px", "max": "50px" } },
        { "slug": "heading-2", "name": "Heading 2", "size": "46px", "fluid": { "min": "30px", "max": "46px" } },
        { "slug": "heading-3", "name": "Heading 3", "size": "1.25rem" },
        { "slug": "heading-4", "name": "Heading 4", "size": "1.125rem" },
        { "slug": "heading-5", "name": "Heading 5", "size": "1rem" },
        { "slug": "heading-6", "name": "Heading 6", "size": "0.875rem" },
        { "slug": "body", "name": "Body", "size": "16px", "fluid": { "min": "14px", "max": "16px" } },
        { "slug": "small", "name": "Small", "size": "0.875rem" },
        { "slug": "caption", "name": "Caption", "size": "0.625rem" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "customSpacingSize": false,
      "units": ["px", "rem", "%", "vw"],
      "spacingScale": { "operator": "+", "increment": 0.25, "steps": 8, "mediumStep": 1, "unit": "rem", "startValue": 0.25 },
      "spacingSizes": [
        { "slug": "space-10", "name": "10px", "size": "0.625rem" },
        { "slug": "space-20", "name": "14px", "size": "0.875rem" },
        { "slug": "space-30", "name": "16px", "size": "1rem" },
        { "slug": "space-40", "name": "24px", "size": "1.5rem" },
        { "slug": "space-50", "name": "32px", "size": "2rem" },
        { "slug": "space-60", "name": "48px", "size": "3rem" },
        { "slug": "space-70", "name": "54px", "size": "3.38rem" },
        { "slug": "space-80", "name": "81px", "size": "5.06rem" }
      ]
    },
    "blocks": {
      "core/button": { "border": { "radius": true } },
      "core/heading": { "typography": { "customFontSize": false } }
    }
  },
  "styles": {
    "color": { "background": "#FFFFFF", "text": "#334155" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "fontSize": "var(--wp--preset--font-size--body)", "lineHeight": "1.65", "fontWeight": "400" },
    "spacing": { "blockGap": "24px" },
    "elements": {
      "heading": { "typography": { "fontFamily": "var(--wp--preset--font-family--manrope)", "fontWeight": "600", "lineHeight": "1.1" } },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)", "lineHeight": "1.04", "letterSpacing": "-0.055em" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-2)", "lineHeight": "1.1", "letterSpacing": "-0.045em" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--heading-3)", "lineHeight": "1.25", "letterSpacing": "-0.025em" } },
      "button": { "typography": { "fontFamily": "var(--wp--preset--font-family--inter)", "fontWeight": "600" }, "border": { "radius": "999px" } },
      "link": { "color": { "text": "#047857" } }
    },
    "blocks": {
      "core/group": { "spacing": { "blockGap": "24px" } },
      "core/button": { "color": { "background": "#047857", "text": "#FFFFFF" }, "spacing": { "padding": { "top": "14px", "bottom": "14px", "left": "22px", "right": "22px" } } }
    }
  }
}
