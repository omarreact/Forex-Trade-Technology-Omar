          "color": "#c3d982"
        },
        {
          "name": "stone",
          "slug": "stone",
          "color": "#f4f5f0"
        },
        {
          "name": "white",
          "slug": "white",
          "color": "#ffffff"
        },
        {
          "name": "muted",
          "slug": "muted",
          "color": "#767970"
        },
        {
          "name": "border",
          "slug": "border",
          "color": "#dedfd8"
        },
        {
          "name": "footerBg",
          "slug": "footer-bg",
          "color": "#10130f"
        },
        {
          "name": "ctaBg",
          "slug": "cta-bg",
          "color": "#e8f1d8"
        },
        {
          "name": "ctaHomeStart",
          "slug": "cta-home-start",
          "color": "#e5f0c9"
        },
        {
          "name": "ctaHomeEnd",
          "slug": "cta-home-end",
          "color": "#f3f8e9"
        },
        {
          "name": "ctaInk",
          "slug": "cta-ink",
          "color": "#172118"
        },
        {
          "name": "ctaMuted",
          "slug": "cta-muted",
          "color": "#45543f"
        },
        {
          "name": "ctaAction",
          "slug": "cta-action",
          "color": "#1b281c"
        },
        {
          "name": "ctaAccent",
          "slug": "cta-accent",
          "color": "#63842f"
        },
        {
          "name": "sectionHeading",
          "slug": "section-heading",
          "color": "#161816"
