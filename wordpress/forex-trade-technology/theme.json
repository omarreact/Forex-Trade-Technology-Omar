        },
        {
          "name": "sectionEyebrow",
          "slug": "section-eyebrow",
          "color": "#637d2b"
        },
        {
          "name": "cardTitle",
          "slug": "card-title",
          "color": "#161816"
        },
        {
          "name": "cardDescription",
          "slug": "card-description",
          "color": "#4c5c53"
        },
        {
          "name": "cardIconBackground",
          "slug": "card-icon-background",
          "color": "#d8e9a2"
        },
        {
          "name": "cardIconForeground",
          "slug": "card-icon-foreground",
          "color": "#161816"
        }
      ],
      "defaultPalette": false,
      "custom": false,
      "customGradient": false
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "name": "Manrope \u2014 headings",
          "slug": "display",
          "fontFamily": "Manrope,Inter,system-ui,sans-serif"
        },
        {
          "name": "Inter \u2014 body",
          "slug": "body",
          "fontFamily": "Inter,system-ui,sans-serif"
        }
      ],
      "fontSizes": [
        {
          "name": "Body",
          "slug": "body",
          "size": "16px"
        },
        {
          "name": "Small",
          "slug": "small",
          "size": "14px"
        },
        {
          "name": "H3",
          "slug": "h3",
          "size": "clamp(19px,2vw,24px)"
        },
        {
          "name": "H2",
          "slug": "h2",
          "size": "clamp(30px,3.7vw,46px)"
        },
        {
          "name": "Hero",
          "slug": "hero",
          "size": "clamp(36px,5.5vw,72px)"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw"
      ],
      "spacingSizes": [
        {
          "name": "XS",
          "slug": "xs",
          "size": "8px"
        },
        {
          "name": "S",
          "slug": "s",
          "size": "16px"
        },
        {
          "name": "M",
          "slug": "m",
          "size": "24px"
        },
        {
          "name": "L",
          "slug": "l",
          "size": "40px"
        },
        {
          "name": "XL",
          "slug": "xl",
          "size": "64px"
        },
        {
          "name": "Section",
          "slug": "section",
          "size": "clamp(48px,5.5vw,72px)"
        }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#fff",
      "text": "#161816"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "lineHeight": "1.6"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700"
        }
      },
      "button": {
        "color": {
          "background": "#d8e9a2",
          "text": "#161816"
        },
        "border": {
          "radius": "999px"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Site Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Site Footer",
      "area": "footer"
    },
    {
      "name": "final-cta",
      "title": "Global Final CTA",
      "area": "uncategorized"
    }
  ]
}
