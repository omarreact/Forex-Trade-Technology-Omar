          "color": "#161816"
        }
      ],
      "defaultPalette": false
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "fontFamily": "Inter, system-ui, sans-serif",
          "name": "Body · Inter",
          "slug": "body"
        },
        {
          "fontFamily": "Manrope, Inter, system-ui, sans-serif",
          "name": "Headings · Manrope",
          "slug": "display"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ],
      "blockGap": "20px",
      "padding": true,
      "margin": true
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "8px"
        }
      }
    }
  },
  "styles": {
    "color": {
      "text": "var(--wp--preset--color--ink)",
      "background": "var(--wp--preset--color--white)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)"
        }
      }
    }
  }
}
