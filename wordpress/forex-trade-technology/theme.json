{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "title": "Forex Trade Technology",
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1210px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        {
          "name": "ink",
          "slug": "ink",
          "color": "#161816"
        },
        {
          "name": "dark",
          "slug": "dark",
          "color": "#141613"
        },
        {
          "name": "deep",
          "slug": "deep",
          "color": "#101210"
        },
        {
          "name": "lime",
          "slug": "lime",
          "color": "#d8e9a2"
        },
        {
          "name": "limeStrong",
          "slug": "lime-strong",
          "color": "#c3d982"
        },
        {
          "name": "stone",
          "slug": "stone",
          "color": "#f4f5f0"
        },
        {
          "name": "white",
          "slug": "white",
          "color": "#ffffff"
        },
        {
          "name": "muted",
          "slug": "muted",
          "color": "#767970"
        },
        {
          "name": "border",
          "slug": "border",
          "color": "#dedfd8"
        },
        {
          "name": "ctaBg",
          "slug": "cta-bg",
          "color": "#e8f1d8"
        },
        {
          "name": "ctaInk",
          "slug": "cta-ink",
          "color": "#172118"
        },
        {
          "name": "ctaAccent",
          "slug": "cta-accent",
          "color": "#63842f"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "Inter, system-ui, sans-serif",
          "name": "Inter (Body)",
          "slug": "body"
        },
        {
          "fontFamily": "Manrope, Inter, system-ui, sans-serif",
          "name": "Manrope (Display)",
          "slug": "display"
        }
      ],
      "fontSizes": [
        {
          "name": "Body",
          "slug": "body",
          "size": "clamp(14px, calc(13.427px + 0.179vw), 16px)"
        },
        {
          "name": "H1",
          "slug": "h1",
          "size": "clamp(40px, 5.5vw, 72px)"
        },
        {
          "name": "H2",
          "slug": "h2",
          "size": "clamp(30px, 3.65vw, 46px)"
        },
        {
          "name": "H3",
          "slug": "h3",
          "size": "clamp(20px, 1.8vw, 23px)"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "em",
        "rem",
        "%",
        "vw",
        "vh"
      ],
      "spacingSizes": [
        {
          "name": "Small",
          "slug": "small",
          "size": "16px"
        },
        {
          "name": "Section",
          "slug": "section",
          "size": "clamp(48px, 5.5vw, 72px)"
        },
        {
          "name": "Large",
          "slug": "large",
          "size": "72px"
        }
      ]
    },
    "custom": {
      "ftt": {
        "sectionGap": "clamp(48px, 5.5vw, 72px)",
        "headerHeight": "72px",
        "cardGap": "16px",
        "cardPadding": "clamp(20px, 2.2vw, 27px)"
      }
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#161816"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.65"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700"
        }
      },
      "link": {
        "color": {
          "text": "#161816"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Site Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Site Footer",
      "area": "footer"
    },
    {
      "name": "final-cta",
      "title": "Final CTA",
      "area": "uncategorized"
    },
    {
      "name": "final-cta-home",
      "title": "Home Final CTA",
      "area": "uncategorized"
    }
  ],
  "customTemplates": [
    {
      "name": "landing",
      "title": "Landing Page",
      "postTypes": [
        "page"
      ]
    }
  ]
}
