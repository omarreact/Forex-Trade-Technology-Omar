{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "forex-trade-technology/icon-card",
  "version": "0.1.0",
  "title": "Icon Card",
  "category": "design",
  "icon": "layout",
  "description": "FSE block rendered from Phase B Next.js-compatible data contracts.",
  "textdomain": "forex-trade-technology",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "icon": {
      "type": "string",
      "default": "check"
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "paragraphs": {
      "type": "array",
      "default": []
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "anchor": false,
    "customClassName": true,
    "multiple": true
  }
}
