{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "forex-trade-technology/home-slider",
  "title": "Home Slider",
  "category": "design",
  "icon": "layout",
  "description": "Editable Forex Trade Technology section, rendered from migrated content attributes.",
  "textdomain": "forex-trade-technology",
  "attributes": {
    "slides": {
      "type": "array",
      "default": []
    },
    "autoplay": {
      "type": "boolean",
      "default": true
    },
    "intervalMs": {
      "type": "number",
      "default": 6000
    }
  },
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ],
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    }
  }
}
