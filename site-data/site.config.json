      "enabled": true,
      "docs": "https://nextjs.org/docs/app/guides/view-transitions",
      "types": [
        "page",
        "section",
        "hero",
        "card",
        "slider"
      ],
      "defaultTransition": "fade-slide"
    },
    "icons": {
      "provider": "nexticons",
