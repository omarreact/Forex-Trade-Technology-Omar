{
  "themeId": "broker-setup-lime",
  "name": "Forex Trade Technology — Lime Fintech",
  "basedOn": "forex-trade-technology-preview-2.html",
  "fonts": {
    "sans": [
      "Inter",
      "Manrope",
      "system-ui",
      "sans-serif"
    ],
    "googleFonts": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap"
  },
  "tokens": {
    "colors": {
      "ink": "#161816",
      "dark": "#141613",
      "deep": "#101210",
      "lime": "#d9f17a",
      "limeStrong": "#cde760",
      "stone": "#f4f5f0",
      "white": "#ffffff",
      "muted": "#767970",
      "border": "#dedfd8",
      "accentText": "#80867e",
      "heroGradient": "linear-gradient(126deg, #0c0e0e 6%, #171a16 70%, #252c1e 100%)",
      "contactGradient": "linear-gradient(135deg, #181c15, #0d100e)",
      "roadmapBg": "#f3f4ef",
      "faqBg": "#f5f6f2",
      "footerBg": "#0f110f"
    },
    "radius": {
      "sm": "8px",
      "md": "13px",
      "lg": "18px",
      "xl": "22px",
      "pill": "100px"
    },
    "shell": "min(1210px, calc(100% - 88px))",
    "spacing": {
      "sectionY": "clamp(75px, 9vw, 116px)",
      "headerH": "88px"
    },
    "shadows": {
      "card": "0 16px 30px rgba(25, 29, 25, 0.025)",
      "cardHover": "0 18px 40px rgba(22, 36, 22, 0.09)",
      "header": "0 8px 22px rgba(16, 24, 17, 0.06)"
    },
    "typography": {
      "h1": "clamp(48px, 6vw, 88px)",
      "h2": "clamp(42px, 4.9vw, 72px)",
      "h3": "28px",
      "body": "17px",
      "kicker": "12px",
      "letterSpacingTight": "-0.065em"
    }
  },
  "components": {
    "header": {
      "sticky": true,
      "className": "bs-site-header",
      "logoClass": "bs-logo-text",
      "navClass": "bs-inline-nav",
      "ctaClass": "bs-btn-dark"
    },
    "buttons": {
      "primary": {
        "className": "bs-btn-primary",
        "bg": "var(--bs-lime)",
        "color": "#171a14"
      },
      "dark": {
        "className": "bs-btn-dark",
        "bg": "#171915",
        "color": "#fff"
      },
      "line": {
        "className": "bs-btn-line"
      }
    },
    "hero": {
      "className": "bs-hero",
      "minHeight": "clamp(630px, 68vw, 760px)",
      "kickerClass": "bs-hero-kicker",
      "titleClass": "bs-hero-title",
      "subtitleClass": "bs-hero-subtitle"
    },
    "cards": {
      "step": "bs-step-card",
      "advantage": "bs-adv-card",
      "solution": "bs-card"
    },
    "faq": {
      "accordion": true,
      "className": "bs-faq-accordion",
      "openFirst": true
    },
    "scrollToTop": {
      "className": "bs-scroll-top",
      "style": {
        "position": "fixed",
        "right": "24px",
        "bottom": "24px",
        "width": "48px",
        "height": "48px",
        "borderRadius": "100px",
        "background": "#d9f17a",
        "color": "#171a14",
        "border": "none",
        "cursor": "pointer",
        "zIndex": 90,
        "boxShadow": "0 8px 24px rgba(0,0,0,0.15)",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center"
      }
    }
  },
  "viewTransitions": {
    "page": {
      "name": "page-transition",
      "type": "fade-slide",
      "duration": "280ms"
    },
    "hero": {
      "name": "hero-transition",
      "type": "fade-up",
      "duration": "400ms"
    },
    "section": {
      "name": "section-transition",
      "type": "fade",
      "duration": "320ms"
    },
    "card": {
      "name": "card-transition",
      "type": "scale-fade",
      "duration": "240ms"
    }
  },
  "assets": {
