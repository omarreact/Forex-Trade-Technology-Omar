{
  "themeId": "broker-setup-lime-v5-no-repeat",
  "name": "Forex Trade Technology — Dense Professional",
  "basedOn": "forex-trade-technology-preview-2.html + live forextrade.pincodeit.com",
  "fonts": {
    "sans": [
      "Inter",
      "Manrope",
      "system-ui",
      "sans-serif"
    ],
    "googleFonts": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap"
  },
  "tokens": {
    "colors": {
      "ink": "#161816",
      "dark": "#141613",
      "deep": "#101210",
      "lime": "#d8e9a2",
      "limeStrong": "#c3d982",
      "stone": "#f4f5f0",
      "white": "#ffffff",
      "muted": "#767970",
      "border": "#dedfd8",
      "heroGradient": "linear-gradient(126deg, #0c0e0e 6%, #171a16 70%, #252c1e 100%)",
      "headerBarGradient": "linear-gradient(120deg, #0c0e0e 0%, #1a2218 55%, #0f1410 100%)",
      "contactGradient": "linear-gradient(135deg, #181c15, #0d100e)",
      "footerBg": "#0f110f"
    },
    "radius": {
      "sm": "8px",
      "md": "13px",
      "lg": "18px",
      "xl": "22px",
      "pill": "100px"
    },
    "shell": "min(1210px, calc(100% - 88px))",
    "innerHeaderHeight": "240px",
    "spacing": {
      "sectionY": "clamp(48px, 5.5vw, 72px)",
      "headerH": "72px",
      "sectionYTight": "clamp(36px, 4vw, 56px)",
      "blockGap": "20px",
      "cardGap": "16px"
    },
    "typography": {
      "h1": "clamp(40px, 5.5vw, 72px)",
      "h1Inner": "clamp(32px, 4vw, 48px)",
      "h2": "clamp(30px, calc(21.2px + 1.72vw), 46px)",
      "h3": "22px",
      "body": "17px",
      "kicker": "12px"
    }
  },
  "components": {
    "homeSlider": {
      "className": "bs-home-slider",
      "fullWidth": true,
      "minHeight": "clamp(480px, 62vh, 640px)",
      "overlay": "linear-gradient(90deg, rgba(8,12,8,0.88) 0%, rgba(8,12,8,0.55) 55%, rgba(8,12,8,0.25) 100%)",
      "contentMaxWidth": "640px",
      "dots": true,
      "arrows": true
    },
    "pageHeader": {
      "className": "bs-page-header",
      "height": "240px",
      "padding": "0 24px",
      "breadcrumbClass": "bs-breadcrumb",
      "titleClass": "bs-page-title",
      "kickerClass": "bs-kicker"
    },
    "scrollToTop": {
      "className": "bs-scroll-top",
      "style": {
        "position": "fixed",
        "right": "24px",
        "bottom": "24px",
        "width": "48px",
        "height": "48px",
        "borderRadius": "100px",
        "background": "#d8e9a2",
        "color": "#171a14",
        "border": "none",
        "cursor": "pointer",
        "zIndex": 90,
        "boxShadow": "0 8px 24px rgba(0,0,0,0.15)"
      }
    },
    "imageLayouts": {
      "rules": [
        "Never place a single decorative image alone on the right of a short text block with large empty space.",
        "Prefer 2x2 or 3-column card grids for feature lists.",
        "Use split 50/50 only when BOTH sides have substantial content (text min ~120 words OR multi-bullet list).",
        "For process steps use numbered horizontal timeline or compact 3-col cards, not one big photo.",
        "FAQ: full-width accordion, optional small illustration in sticky sidebar only if viewport > 1100px.",
        "CTA bands: full-width dark/lime with optional background image at low opacity, text centered or left with button."
      ],
      "allowed": {
        "cardGrid2": "2-column equal cards with optional top icon or small thumb (120px)",
        "cardGrid3": "3-column equal cards",
        "cardGrid4": "4-column on desktop, 2 on tablet",
        "splitEqual": "50/50 text + image only if text is long; image object-fit cover, rounded-xl",
        "splitContent": "60/40 text heavy + supporting visual",
        "mediaBand": "Full-width image 280–360px height with caption overlay, between sections",
        "iconRow": "Horizontal icons + labels, no large photo",
        "timeline": "Horizontal or vertical numbered steps, compact",
        "stack": "Text only, max-width 720px, no side image",
        "ctaBand": "Full bleed dark or lime CTA",
        "gallery3": "3 equal photos in a row with short captions"
      },
      "forbidden": [
        "singleRightFloat",
        "largeEmptyWhitespaceBesideOneImage",
        "heroHeightOnInnerPages"
      ]
    },
    "sectionDensity": {
      "maxWidthProse": "720px",
      "cardMinHeight": "auto",
      "avoidMinHeightForced": true,
      "paddingX": "clamp(16px, 4vw, 24px)",
      "titleMarginBottom": "12px",
      "subtitleMarginBottom": "20px"
    },
    "sectionVariety": {
      "rule": "Each section.layout at most once per page; never consecutive duplicates",
      "rule2": "Original source fullBlocks are rendered through supplemental details for content fidelity",
      "designs": [
        "cardGrid3",
        "cardGrid2",
        "stack",
        "mediaBand",
        "timeline",
        "splitContent",
        "darkBand",
        "iconRow",
        "faqAccordion",
        "ctaBand",
        "gallery3",
        "statsRow"
      ]
    }
  },
  "viewTransitions": {
    "page": {
      "name": "page-transition",
      "type": "fade-slide",
      "duration": "280ms"
    },
    "slider": {
      "name": "home-slider",
      "type": "fade-cross",
      "duration": "700ms"
    },
    "section": {
      "name": "section-transition",
      "type": "fade",
      "duration": "320ms"
    },
    "card": {
      "name": "card-transition",
      "type": "scale-fade",
      "duration": "240ms"
    }
  },
