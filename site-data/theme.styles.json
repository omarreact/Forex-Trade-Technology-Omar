{
  "themeId": "broker-setup-lime-v3",
  "name": "Forex Trade Technology — Lime Fintech",
  "basedOn": "forex-trade-technology-preview-2.html + live forextrade.pincodeit.com",
  "fonts": {
    "sans": [
      "Inter",
      "Manrope",
      "system-ui",
      "sans-serif"
    ],
    "googleFonts": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap"
  },
  "tokens": {
    "colors": {
      "ink": "#161816",
      "dark": "#141613",
      "deep": "#101210",
      "lime": "#d9f17a",
      "limeStrong": "#cde760",
      "stone": "#f4f5f0",
      "white": "#ffffff",
      "muted": "#767970",
      "border": "#dedfd8",
      "heroGradient": "linear-gradient(126deg, #0c0e0e 6%, #171a16 70%, #252c1e 100%)",
      "headerBarGradient": "linear-gradient(120deg, #0c0e0e 0%, #1a2218 55%, #0f1410 100%)",
      "contactGradient": "linear-gradient(135deg, #181c15, #0d100e)",
      "footerBg": "#0f110f"
    },
    "radius": {
      "sm": "8px",
      "md": "13px",
      "lg": "18px",
      "xl": "22px",
      "pill": "100px"
    },
    "shell": "min(1210px, calc(100% - 88px))",
    "innerHeaderHeight": "300px",
    "spacing": {
      "sectionY": "clamp(64px, 8vw, 110px)",
      "headerH": "88px"
    },
    "typography": {
      "h1": "clamp(40px, 5.5vw, 72px)",
      "h1Inner": "clamp(32px, 4vw, 48px)",
      "h2": "clamp(28px, 3.5vw, 44px)",
      "h3": "22px",
      "body": "17px",
      "kicker": "12px"
    }
  },
  "components": {
    "homeSlider": {
      "className": "bs-home-slider",
      "fullWidth": true,
      "minHeight": "clamp(560px, 72vh, 820px)",
      "overlay": "linear-gradient(90deg, rgba(8,12,8,0.88) 0%, rgba(8,12,8,0.55) 55%, rgba(8,12,8,0.25) 100%)",
      "contentMaxWidth": "640px",
      "dots": true,
      "arrows": true
    },
    "pageHeader": {
      "className": "bs-page-header",
      "height": "300px",
      "padding": "0 24px",
      "breadcrumbClass": "bs-breadcrumb",
      "titleClass": "bs-page-title",
      "kickerClass": "bs-kicker"
    },
    "scrollToTop": {
      "className": "bs-scroll-top",
      "style": {
        "position": "fixed",
        "right": "24px",
        "bottom": "24px",
        "width": "48px",
        "height": "48px",
        "borderRadius": "100px",
        "background": "#d9f17a",
        "color": "#171a14",
        "border": "none",
        "cursor": "pointer",
        "zIndex": 90,
        "boxShadow": "0 8px 24px rgba(0,0,0,0.15)"
      }
    },
    "imageLayouts": {
      "splitLeft": "Image left 45% / text right 55%",
      "splitRight": "Text left 55% / image right 45%",
      "fullBleed": "Full-width image with caption overlay",
      "cardThumb": "Card with top image 180–220px",
      "gridGallery": "2–3 column image grid with captions",
      "backgroundWash": "Section background image at 20–30% opacity"
    }
  },
  "viewTransitions": {
    "page": {
      "name": "page-transition",
      "type": "fade-slide",
      "duration": "280ms"
    },
    "slider": {
      "name": "home-slider",
      "type": "fade-cross",
      "duration": "700ms"
    },
    "section": {
      "name": "section-transition",
      "type": "fade",
      "duration": "320ms"
    },
    "card": {
      "name": "card-transition",
      "type": "scale-fade",
      "duration": "240ms"
    }
  },
