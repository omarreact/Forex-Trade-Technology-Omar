{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "860px",
      "wideSize": "1210px"
    },
    "color": {
      "palette": [
        {
          "slug": "ink",
          "color": "#161816",
          "name": "Ink"
        },
        {
          "slug": "dark",
          "color": "#141613",
          "name": "Dark"
        },
        {
          "slug": "lime",
          "color": "#d9f17a",
          "name": "Lime Accent"
        },
        {
          "slug": "stone",
          "color": "#f4f5f0",
          "name": "Stone"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "system",
          "name": "Arial / Helvetica",
          "fontFamily": "Arial, Helvetica, sans-serif"
        }
      ]
    },
    "spacing": {
      "units": [
        "px",
        "rem",
        "em",
        "%",
        "vw",
        "vh"
      ]
    }
  },
  "styles": {
    "color": {
      "background": "#ffffff",
      "text": "#161816"
    },
    "spacing": {
      "blockGap": "0px"
    },
    "typography": {
      "fontFamily": "Arial, Helvetica, sans-serif"
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Site Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Site Footer",
      "area": "footer"
    }
  ],
  "customTemplates": [
    {
      "name": "page-roadmap",
      "title": "Original BrokerSetup Roadmap",
      "postTypes": [
        "page"
      ]
    },
    {
      "name": "page-forex-content",
      "title": "Forex Trade Technology Content",
      "postTypes": [
        "page"
      ]
    }
  ]
}
