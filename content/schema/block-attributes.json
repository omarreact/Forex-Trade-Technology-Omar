{
  "contractVersion": 1,
  "namespace": "forex-trade-technology",
  "blocks": {
    "home-slider": {
      "component": "blocks/home-slider/HomeSlider.tsx",
      "attributes": {
        "slides": {
          "type": "array",
          "required": true,
          "items": {
            "type": "object",
            "required": [
              "imageKey",
              "title"
            ],
            "properties": {
              "imageKey": "string",
              "title": "string",
              "kicker": "string",
              "subtitle": "string",
              "cta": "object"
            }
          }
        },
        "intervalMs": {
          "type": "number",
          "default": 6000
        },
        "autoplay": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "trading-stack-flow": {
      "component": "blocks/trading-stack-flow/TradingStackFlow.tsx",
      "attributes": {
        "section": {
          "type": "object",
          "required": true,
          "description": "Section content document"
        },
        "visual": {
          "type": "object",
          "required": true,
          "description": "Diagram labels, captions and node list"
        }
      }
    },
    "trust-carousel": {
      "component": "blocks/trust-carousel/TrustCarousel.tsx",
      "attributes": {
        "items": {
          "type": "array",
          "required": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "audience-carousel": {
      "component": "blocks/audience-carousel/AudienceCarousel.tsx",
      "attributes": {
        "title": {
          "type": "string",
          "required": true
        },
        "kicker": {
          "type": "string",
          "default": "FOREX TRADE TECHNOLOGY"
        },
        "items": {
          "type": "array",
          "required": true,
          "items": {
            "type": "object"
          }
        }
      }
    },
    "icon-card": {
      "component": "blocks/icon-card/IconCard.tsx",
      "attributes": {
        "icon": {
          "type": "string",
          "required": true
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "paragraphs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "className": {
          "type": "string",
          "description": "Presentation class; future WP uses core customClassName"
        }
      }
    },
    "contact-form": {
      "component": "blocks/contact-form/ContactForm.tsx",
      "attributes": {},
      "notes": "Presentation currently has no external block attributes; form transport stays Next API. Phase B may move labels/options to content contract."
    }
  }
}
