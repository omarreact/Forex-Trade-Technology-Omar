{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "id": "ftt-editorial-v1",
  "project": "Forex Trade Technology",
  "revision": "2026-10-21",
  "description": "Canonical portable design tokens. Keep in sync with docs/FOREX_THEME_MASTER_SPEC.md.",
  "colors": {
    "ink": "#161816",
    "dark": "#141613",
    "forest": "#17251A",
    "heading": "#1B2B1E",
    "heroFallback": "#111F16",
    "lime": "#D9F17A",
    "limeStrong": "#CDE760",
    "white": "#FFFFFF",
    "stone": "#F4F5F0",
    "cream": "#F6F8F2",
    "muted": "#5E6E60",
    "border": "#DFE8DA",
    "editorialLight": "#F5F8F0",
    "link": "#3D6D30",
    "headingAccent": "#B4D184"
  },
  "typography": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "externalFonts": false,
    "weight": {
      "regular": 400,
      "medium": 600,
      "bold": 700,
      "extraBold": 800
    },
    "sizes": {
      "heroH1Desktop": "clamp(39px,3.65vw,56px)",
      "heroH1Mobile": "clamp(30px,8vw,38px)",
      "interiorH1Desktop": "clamp(36px,4.4vw,63px)",
      "interiorH1Mobile": "clamp(33px,8.5vw,44px)",
      "editorialH2": "clamp(33px,3.8vw,53px)",
      "interiorH2": "clamp(30px,3.6vw,48px)",
      "body": "15px–17px",
      "eyebrow": "10px–11px",
      "button": "12px–14px",
      "heroH1LongDesktop": "clamp(36px,3.25vw,50px)",
      "heroH1LongMobile": "clamp(30px,8vw,38px)"
    },
    "lineHeight": {
      "body": "1.65–1.75",
      "heroTitle": 1.045,
      "interiorTitle": 1.075
    },
    "dualToneHeadings": {
      "firstHalf": "inherit existing heading color",
      "secondHalf": "#B4D184",
      "split": "closest word boundary to midpoint",
      "appliesTo": "all H1-H6, static Gutenberg and React"
    }
  },
  "grid": {
    "readingWidth": "860px",
    "wideWidth": "1210px",
    "desktopGutter": "36px–44px",
    "mobileGutter": "18px–24px",
    "mobileMax": 640,
    "tabletMax": 960
  },
  "radius": {
    "card": "13px–22px",
    "image": "17px–22px",
    "button": "999px"
  },
  "spacing": {
    "sectionDesktop": "45px–75px",
    "sectionMobile": "38px–45px",
    "photoTextGap": "20px–28px",
    "insetPhotoWidth": "35%–45%",
    "footerTop": "44px",
    "footerBottom": "19px"
  },
  "photo": {
    "source": "Real licensed external editorial photography only",
    "generator": "none",
    "bannerUse": "real photographs; no SVG diagrams",
    "displaySourceLinks": false,
    "sourceFile": "lib/pexels-photos.ts",
    "layoutVariants": [
      "photo-left",
      "photo-right",
      "photo-center",
      "photo-blurred-background",
      "photo-parallax-desktop"
    ],
    "insetObjectFit": "cover",
    "desktopParallax": "background-attachment: fixed",
    "reducedMotionFallback": "background-attachment: scroll"
  },
  "motion": {
    "heroCrossfadeMs": 900,
    "heroAutoplayMs": 7000,
    "hoverMs": "200–350",
    "respectsReducedMotion": true,
    "heroTransition": "whole-slide-translateX",
    "heroTransitionMs": 850,
    "heroSlideContent": [
      "photo",
      "eyebrow",
      "heading",
      "lead",
      "description",
      "primaryCTA",
      "secondaryCTA",
      "slideNumber"
    ],
    "heroH1Placement": "first-slide-only"
  },
  "components": [
    "SiteHeader",
    "SiteFooter",
    "HomeHero",
    "HomeCapabilityStrip",
    "InteriorPageShell",
    "InteriorEditorialFlow",
    "InlineBreak",
    "ParallaxBreak"
  ],
  "nativeWordPress": {
    "version": "6.6+",
    "themeJsonVersion": 3,
    "layout": {
      "contentSize": "860px",
      "wideSize": "1210px"
    },
    "templateParts": [
      "header",
      "footer"
    ],
    "patternNames": [
      "ftt/hero",
      "ftt/media-left",
      "ftt/media-right",
      "ftt/media-center",
      "ftt/photo-blur",
      "ftt/parallax",
      "ftt/faq",
      "ftt/cta",
      "ftt/compact-footer"
    ],
    "blockTypes": [
      "core/group",
      "core/columns",
      "core/heading",
      "core/paragraph",
      "core/image",
      "core/cover",
      "core/buttons",
      "core/details",
      "core/navigation",
      "core/query"
    ],
    "requiresCustomCarouselBlock": true
  },
  "content": {
    "manifest": "public/theme-assets/content/page-manifest.json",
    "pageCount": 23,
    "originalHtmlDir": "public/theme-assets/content/pages",
    "preserveCopyAndUrls": true
  },
  "urls": {
    "canonicalProduction": "https://forextrade.pincodeit.com/"
  },
  "header": {
    "desktopInlineNavigationMin": 1024,
    "mobileDrawerMax": 1023,
    "desktopMaxWidth": "1320px",
    "desktopMinGutter": "20px",
    "inlineItems": [
      "Home",
      "Solutions",
      "Products",
      "Technology",
      "Portfolio",
      "About",
      "FAQs",
      "Market Intel"
    ],
    "cta": "Contact Us",
    "publicAdminButton": false
  }
}
