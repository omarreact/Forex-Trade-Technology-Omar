{
  "id": "leverate",
  "name": "Leverate Inspired",
  "reference": "https://leverate.com/",
  "colors": {
    "primary": "#432387",
    "accent": "#d98afc",
    "background": "#f8f4ff",
    "ink": "#2b1f58",
    "border": "#e0d3f8",
    "surface": "#ffffff"
  },
  "typography": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "headingSizes": {
      "display": "clamp(38px, 5.2vw, 78px)",
      "section": "clamp(26px, 3.1vw, 49px)"
    },
    "tracking": "-0.045em",
    "bodyLineHeight": 1.72
  },
  "layout": {
    "contentMaxWidthPx": 1420,
    "sectionSpacingPx": 64
  },
  "radiusPx": 26,
  "breakpointsPx": {
    "narrowDesktop": 900,
    "mobile": 768
  },
  "respectsReducedMotion": true
}
