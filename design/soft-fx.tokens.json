{
  "id": "soft-fx",
  "name": "Soft-FX Inspired",
  "reference": "https://www.soft-fx.com/",
  "colors": {
    "primary": "#122b38",
    "accent": "#29b897",
    "background": "#ecf3f5",
    "ink": "#1a303d",
    "border": "#bdd1d6",
    "surface": "#ffffff"
  },
  "typography": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "headingSizes": {
      "display": "clamp(38px, 5.2vw, 78px)",
      "section": "clamp(26px, 3.1vw, 49px)"
    },
    "tracking": "-0.045em",
    "bodyLineHeight": 1.72
  },
  "layout": {
    "contentMaxWidthPx": 1420,
    "sectionSpacingPx": 64
  },
  "radiusPx": 4,
  "breakpointsPx": {
    "narrowDesktop": 900,
    "mobile": 768
  },
  "respectsReducedMotion": true
}
