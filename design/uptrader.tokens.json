{
  "id": "uptrader",
  "name": "UpTrader Inspired",
  "reference": "https://uptrader.io/",
  "colors": {
    "primary": "#26463b",
    "accent": "#e89146",
    "background": "#fffaf2",
    "ink": "#25453b",
    "border": "#e6ded0",
    "surface": "#ffffff"
  },
  "typography": {
    "fontFamily": "Arial, Helvetica, sans-serif",
    "headingSizes": {
      "display": "clamp(38px, 5.2vw, 78px)",
      "section": "clamp(26px, 3.1vw, 49px)"
    },
    "tracking": "-0.045em",
    "bodyLineHeight": 1.72
  },
  "layout": {
    "contentMaxWidthPx": 1420,
    "sectionSpacingPx": 64
  },
  "radiusPx": 32,
  "breakpointsPx": {
    "narrowDesktop": 900,
    "mobile": 768
  },
  "respectsReducedMotion": true
}
